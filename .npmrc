# better-sqlite3@13 ships N-API prebuilds and sets "gypfile": false.
# npm 10 (the npm bundled with Node.js 22) still runs an implicit
# "node-gyp rebuild" when it sees binding.gyp. That fails on machines
# without a C++ toolchain, and on Visual Studio 2026, which node-gyp 11
# does not recognize. Nothing in this tree needs an install script.
ignore-scripts=true
