# OpenAI-compatible LLM endpoint (required for chat / explain / check)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: dedicated web search for the coach (https://tavily.com, has a free tier).
# Without it, search uses the hosted web_search of OpenAI / Azure OpenAI, which other providers lack.
# TAVILY_API_KEY=

# Optional: absolute path for SQLite file (defaults to ./data/english-coach.sqlite)
# DATABASE_PATH=

# Optional: ECDICT sqlite path (defaults to ./data/stardict.db)
# ECDICT_PATH=
